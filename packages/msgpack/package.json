{
  "name": "@dsdenes/msgpack",
  "version": "1.0.0",
  "description": "Byte-compatible, drop-in replacement for @msgpack/msgpack everyday payloads",
  "license": "ISC",
  "type": "module",
  "main": "./lib/index.cjs",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.cjs"
    },
    "./package.json": "./package.json",
    "./lib/*": "./lib/*"
  },
  "sideEffects": false,
  "unpkg": "./lib/msgpack.js",
  "cdn": "./lib/msgpack.js",
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsdenes/msgpack.git",
    "directory": "packages/msgpack"
  },
  "homepage": "https://github.com/dsdenes/msgpack/tree/main/packages/msgpack#readme",
  "bugs": {
    "url": "https://github.com/dsdenes/msgpack/issues"
  },
  "keywords": [
    "msgpack",
    "messagepack",
    "serialization",
    "binary",
    "typescript"
  ]
}
