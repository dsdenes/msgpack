{
  "name": "msgpack-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build.ts",
    "test": "npm run build && node --test test/compat.test.ts test/options.test.ts test/stream.test.ts test/malformed.test.ts",
    "typecheck": "tsc --noEmit",
    "bench": "npm run build && node --expose-gc bench/bench.ts",
    "verify:server": "npm run build && node verification/server-adoption.ts",
    "verify:browser": "npm run build && node verification/browser-adoption.ts",
    "verify:browser-script": "npm run build && node verification/browser-script-adoption.ts",
    "verify:options": "npm run build && node verification/options-compat.ts",
    "verify:multi": "npm run build && node verification/multi-decode.ts",
    "verify:stream": "npm run build && node verification/stream-decode.ts",
    "verify:malformed": "npm run build && node verification/malformed-input.ts",
    "verify:surface": "npm run build && node verification/surface.ts",
    "verify:typed": "npm run build && node verification/typed-adoption.ts",
    "verify:classic-typed": "npm run build && node verification/classic-typed-adoption.ts",
    "verify:classic-bundler": "npm run build && node verification/classic-bundler-adoption.ts",
    "verify:adoption": "npm run build && node verification/server-adoption.ts && node verification/browser-adoption.ts && node verification/typed-adoption.ts && node verification/classic-typed-adoption.ts && node verification/classic-bundler-adoption.ts && node verification/browser-script-adoption.ts"
  },
  "devDependencies": {
    "@dsdenes/msgpack": "*",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "msgpack-javascript-original": "npm:@msgpack/msgpack@3.1.3",
    "typescript": "^5.7.2"
  }
}
