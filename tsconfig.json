{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@msgpack/msgpack": ["packages/msgpack/lib/index.d.ts"]
    }
  },
  "include": [
    "packages/msgpack/src",
    "test",
    "bench",
    "scripts",
    "verification",
    "examples"
  ]
}
